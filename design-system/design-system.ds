                          "body": {
                            "role": "text",
                            "type_variant": "body.small",
                            "sample": "De finibus bonorum et malorum — “On the Ends of Good and Evil” — a treatise on ethics. The passage lives in sections 1.10.32–33.",
                            "tone": "muted"
                          }
                        }
                      },
                      "moment_2": {
                        "role": "group",
                        "gap": {
                          "v": "$primitives.sizes.spacing.xs",
                          "t": "ref"
