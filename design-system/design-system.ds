                            "sample": "Bacon Ipsum"
                          },
                          "flavor": {
                            "role": "text",
                            "type_variant": "body.small",
                            "sample": "Meat filler. Brisket, pancetta, short ribs.",
                            "tone": "muted"
                          }
                        }
                      },
                      "variant_3": {
                        "role": "group",
                        "gap": {
                          "v": "$primitives.sizes.spacing.xs",
                          "t": "ref"
                        },
