                      },
                      "sample": "Generate"
                    },
                    "summary": {
                      "role": "text",
                      "type_variant": "body.small",
                      "sample": "Medium — 4 sentences. Opens with the standard first line. Output is plain text.",
                      "tone": "muted"
                    }
                  }
                }
              }
            },
            "credits": {
              "region": "footer",
              "role": "group",
              "direction": "row",
              "align": "center",
              "gap": {
                "v": "$primitives.sizes.spacing.xl",
