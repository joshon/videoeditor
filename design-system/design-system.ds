                          "title": {
                            "role": "text",
                            "type_variant": "labels.large",
                            "sample": "McClintock finds Cicero"
                          },
                          "body": {
                            "role": "text",
                            "type_variant": "body.small",
                            "sample": "Richard McClintock, a Latin scholar at Hampden–Sydney College, traced the text to Cicero after noticing consectetur — a word too rare to be an accident.",
                            "tone": "muted"
                          }
                        }
                      }
