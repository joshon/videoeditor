                          "title": {
                            "role": "text",
                            "type_variant": "labels.large",
                            "sample": "Letraset puts it on a sheet"
                          },
                          "body": {
                            "role": "text",
                            "type_variant": "body.small",
                            "sample": "Dry-transfer lettering sheets carried Lorem Ipsum as their specimen text, which is how it reached a generation of designers.",
                            "tone": "muted"
                          }
                        }
                      },
                      "moment_4": {
                        "role": "group",
                        "gap": {
                          "v": "$primitives.sizes.spacing.xs",
