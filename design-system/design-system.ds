                      "sample": "$68.00"
                    }
                  }
                },
                "rule": {
                  "role": "divider"
                },
                "costs": {
                  "role": "group",
                  "gap": {
                    "v": "$primitives.sizes.spacing.xs",
                    "t": "ref"
                  },
                  "items": {
                    "subtotal": {
                      "role": "group",
                      "direction": "row",
                      "align": "center",
                      "gap": {
                        "v": "$primitives.sizes.spacing.md",
                        "t": "ref"
                      },
                      "justify": "between",
                      "items": {
                        "name": {
                          "role": "text",
                          "type_variant": "body.small",
                          "sample": "Subtotal"
                        },
                        "value": {
                          "role": "text",
                          "type_variant": "body.small",
                          "sample": "$316.00"
                        }
                      }
                    },
                    "shipping": {
                      "role": "group",
                      "direction": "row",
                      "align": "center",
                      "gap": {
                        "v": "$primitives.sizes.spacing.md",
                        "t": "ref"
                      },
                      "justify": "between",
                      "items": {
                        "name": {
                          "role": "text",
                          "type_variant": "body.small",
                          "sample": "Shipping"
                        },
                        "value": {
                          "role": "text",
                          "type_variant": "body.small",
                          "sample": "Free"
                        }
                      }
                    },
                    "tax": {
                      "role": "group",
                      "direction": "row",
                      "align": "center",
                      "gap": {
                        "v": "$primitives.sizes.spacing.md",
                        "t": "ref"
                      },
                      "justify": "between",
                      "items": {
                        "name": {
                          "role": "text",
                          "type_variant": "body.small",
                          "sample": "Tax",
                          "tone": "muted"
                        },
                        "value": {
                          "role": "text",
                          "type_variant": "body.small",
                          "sample": "$25.28",
                          "tone": "muted"
                        }
                      }
                    }
                  }
                },
                "rule_2": {
                  "role": "divider"
                },
                "total": {
                  "role": "group",
                  "direction": "row",
                  "align": "center",
                  "gap": {
                    "v": "$primitives.sizes.spacing.md",
                    "t": "ref"
                  },
                  "justify": "between",
                  "items": {
                    "name": {
                      "role": "text",
                      "type_variant": "labels.large",
                      "sample": "Total"
                    },
                    "value": {
                      "role": "text",
                      "type_variant": "labels.large",
                      "sample": "$341.28"
                    }
                  }
                },
                "promo": {
                  "role": "group",
                  "direction": "row",
                  "align": "center",
                  "gap": {
                    "v": "$primitives.sizes.spacing.xs",
                    "t": "ref"
                  },
                  "items": {
                    "applied": {
                      "role": "component",
                      "component": {
                        "v": "$components.types.badges.styles.positive",
                        "t": "ref"
                      },
                      "sample": "Promo applied"
                    },
                    "code": {
                      "role": "text",
                      "type_variant": "body.small",
                      "sample": "AUTUMN10",
                      "tone": "muted"
                    }
                  }
                },
                "pay": {
                  "role": "component",
                  "component": {
                    "v": "$components.types.buttons.styles.primary",
                    "t": "ref"
                  },
                  "sample": "Pay now",
                  "stretch": true
                },
                "reassurance": {
                  "role": "group",
                  "direction": "row",
                  "align": "center",
                  "gap": {
                    "v": "$primitives.sizes.spacing.md",
                    "t": "ref"
                  },
                  "justify": "center",
                  "items": {
                    "note": {
                      "role": "text",
                      "type_variant": "body.small",
                      "sample": "You won’t be charged until you confirm.",
                      "tone": "muted"
                    }
                  }
                }
              },
              "featured": true
            }
          }
        }
      }
    }
  }
