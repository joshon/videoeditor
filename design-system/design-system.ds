                  "caveat": {
                    "role": "component",
                    "component": {
                      "v": "$components.types.alerts.styles.warning",
                      "t": "ref"
                    },
                    "sample": "A themed filler is still filler",
                    "body": "Swapping Latin for cupcakes changes the joke, not the problem: none of them can show you a name that overflows its column or a heading that wraps badly in another language."
                  }
                }
              ]
            },
            "form": {
              "region": "generator",
              "role": "group",
              "gap": {
                "v": "$primitives.sizes.spacing.3xl",
                "t": "ref"
              },
              "panel": {
                "v": "$components.types.panels.styles.section",
                "t": "ref"
              },
              "items": {
                "title": {
                  "role": "text",
                  "type_variant": "headers.h3",
                  "sample": "Generate some"
                },
                "fields": {
                  "role": "group",
                  "columns": 2,
                  "min_item_width": {
                    "v": "200",
