                              }
                            }
                          },
                          "title": {
                            "role": "text",
                            "type_variant": "labels.large",
                            "sample": "An unknown printer scrambles it"
                          },
                          "body": {
                            "role": "text",
                            "type_variant": "body.small",
                            "sample": "The traditional account: a compositor took a galley of type and jumbled it to make a specimen book. Widely repeated, not documented.",
                            "tone": "muted"
                          }
                        }
                      },
                      "moment_3": {
                        "role": "group",
                        "gap": {
                          "v": "$primitives.sizes.spacing.xs",
                          "t": "ref"
