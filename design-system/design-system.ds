                              },
                              "provenance": {
                                "role": "component",
                                "component": {
                                  "v": "$components.types.badges.styles.neutral",
                                  "t": "ref"
                                },
                                "sample": "Sourced"
                              }
                            }
                          },
                          "title": {
                            "role": "text",
                            "type_variant": "labels.large",
                            "sample": "Aldus PageMaker ships it"
                          },
                          "body": {
                            "role": "text",
                            "type_variant": "body.small",
                            "sample": "Desktop publishing bundled it as default filler, and the passage went from a printer’s convention to a computing default.",
                            "tone": "muted"
                          }
                        }
                      },
                      "moment_5": {
                        "role": "group",
                        "gap": {
                          "v": "$primitives.sizes.spacing.xs",
