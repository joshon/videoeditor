              "v": "$primitives.sizes.corners.lg",
              "t": "ref"
            }
          }
        },
        "thumbnail": {
          "_description": "Small and square, for a list or a picker.",
          "properties": {
            "aspect_ratio": {
              "v": "1 / 1",
              "t": "string"
            },
            "corner_radius": {
              "v": "$primitives.sizes.corners.sm",
              "t": "ref"
            }
          }
        },
        "avatar": {
