    "templates": {
      "deck": {
        "cover": {
          "description": "The cover of the design system: its name, description, version and colors.",
          "layout": {
            "v": "$layouts.deck.cover",
            "t": "ref"
          },
          "background": {
            "v": "$color_blocks.surfaces.001",
            "t": "ref"
          },
          "placeholders": {
            "title": {
              "region": "head",
              "role": "text",
              "type_variant": "display.large",
              "sample": "{{name}}",
              "max_lines": 2,
              "size_px": 160
            },
            "description": {
              "region": "head",
              "role": "text",
              "type_variant": "body.large",
              "sample": "{{tagline}}",
              "size_px": 40
            },
            "version": {
              "region": "head",
              "role": "text",
              "type_variant": "body.small",
              "sample": "Version {{version}}",
              "size_px": 28
            },
            "byline": {
              "region": "head",
              "role": "text",
              "type_variant": "body.small",
              "sample": "Created {{date}}",
              "size_px": 24
            },
            "colors": {
              "region": "foot",
              "role": "swatches"
            },
            "credit": {
              "region": "foot",
              "role": "text",
              "type_variant": "body.small",
              "sample": "Created using a .ds file from design-system.studio",
              "size_px": 24
            }
          }
        }
      },
      "web": {
        "lorem_ipsum_page": {
          "description": "Every component on one long page: the page that answers whether the system holds together.",
          "layout": {
            "v": "$layouts.web.lorem_ipsum_page",
            "t": "ref"
          },
          "background": {
            "v": "$color_blocks.surfaces.001",
            "t": "ref"
          },
          "placeholders": {
            "trail": {
              "region": "masthead",
              "role": "component",
              "component": {
                "v": "$components.types.breadcrumbs.styles.default",
                "t": "ref"
              },
              "items": [
                "Typography",
                "Placeholder text",
                "Lorem Ipsum"
              ]
            },
            "intro": {
              "region": "hero",
              "role": "group",
              "gap": {
                "v": "$primitives.sizes.spacing.xl",
                "t": "ref"
              },
              "items": {
                "tags": {
                  "role": "group",
                  "direction": "row",
                  "align": "center",
                  "gap": {
                    "v": "$primitives.sizes.spacing.xs",
                    "t": "ref"
                  },
                  "wrap": true,
                  "items": {
                    "age": {
                      "role": "component",
                      "component": {
                        "v": "$components.types.badges.styles.brand",
                        "t": "ref"
                      },
                      "sample": "45 BC"
                    },
                    "language": {
                      "role": "component",
                      "component": {
                        "v": "$components.types.badges.styles.neutral",
                        "t": "ref"
                      },
                      "sample": "Latin"
                    },
                    "status": {
                      "role": "component",
                      "component": {
                        "v": "$components.types.badges.styles.neutral",
                        "t": "ref"
                      },
                      "sample": "Still in use"
                    }
                  }
                },
                "title": {
                  "role": "text",
                  "type_variant": "display.large",
                  "sample": "Lorem Ipsum"
                },
                "lede": {
                  "role": "text",
                  "type_variant": "body.large",
                  "sample": "The most-read text nobody reads. Two thousand years old, mangled on purpose, and still the fastest way to find out whether a layout works before anyone has written a word of it.",
                  "tone": "muted"
                },
                "action": {
                  "role": "group",
                  "direction": "row",
                  "align": "center",
                  "gap": {
                    "v": "$primitives.sizes.spacing.md",
                    "t": "ref"
                  },
                  "items": {
                    "read": {
                      "role": "component",
                      "component": {
                        "v": "$components.types.buttons.styles.primary",
                        "t": "ref"
                      },
                      "sample": "Read Cicero"
                    }
                  }
                }
              }
            },
            "sample": {
              "region": "passage",
              "role": "group",
              "gap": {
                "v": "$primitives.sizes.spacing.md",
                "t": "ref"
              },
              "panel": {
                "v": "$components.types.panels.styles.section",
                "t": "ref"
              },
              "items": {
                "head": {
                  "role": "group",
                  "direction": "row",
                  "align": "start",
                  "gap": {
                    "v": "$primitives.sizes.spacing.md",
                    "t": "ref"
                  },
                  "justify": "between",
                  "items": {
                    "heading": {
                      "role": "group",
                      "gap": {
                        "v": "$primitives.sizes.spacing.3xs",
                        "t": "ref"
                      },
                      "items": {
                        "kind": {
                          "role": "text",
                          "type_variant": "eyebrow.medium",
                          "sample": "Sample",
                          "tone": "muted"
                        },
                        "title": {
                          "role": "text",
                          "type_variant": "headers.h3",
                          "sample": "The standard passage"
                        }
                      }
                    },
                    "copy": {
                      "role": "component",
                      "component": {
                        "v": "$components.types.buttons.styles.subtle",
                        "t": "ref"
                      },
                      "sample": "Copy",
                      "variant": "icon-regular",
                      "icon": "essential.copy"
                    }
                  }
                },
                "text": {
                  "role": "text",
                  "type_variant": "body.medium",
                  "sample": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum."
