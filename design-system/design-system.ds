                },
                {
                  "why": {
                    "role": "group",
                    "gap": {
                      "v": "$primitives.sizes.spacing.md",
                      "t": "ref"
                    },
                    "panel": {
                      "v": "$components.types.panels.styles.section",
                      "t": "ref"
                    },
                    "items": {
                      "heading": {
                        "role": "group",
                        "gap": {
                          "v": "$primitives.sizes.spacing.3xs",
                          "t": "ref"
                        },
                        "items": {
                          "kind": {
                            "role": "text",
                            "type_variant": "eyebrow.medium",
                            "sample": "Analysis",
                            "tone": "muted"
                          },
                          "title": {
                            "role": "text",
                            "type_variant": "headers.h3",
                            "sample": "Why it works"
                          }
                        }
                      },
                      "lede": {
                        "role": "text",
                        "type_variant": "body.medium",
                        "sample": "The technique has a name — greeking — and one job: give the page the texture of prose without the pull of meaning, so the type, the measure and the rhythm are what you end up judging.",
                        "tone": "muted"
                      },
                      "latin_share": {
                        "role": "group",
                        "gap": {
                          "v": "$primitives.sizes.spacing.xs",
                          "t": "ref"
                        },
                        "items": {
                          "label": {
                            "role": "text",
                            "type_variant": "body.small",
                            "sample": "How much of the passage is recognizably Latin",
                            "tone": "muted"
                          },
                          "bar": {
                            "role": "component",
                            "component": {
                              "v": "$components.types.progress.styles.bar",
                              "t": "ref"
                            },
                            "value": "72"
                          },
                          "note": {
                            "role": "text",
                            "type_variant": "body.small",
                            "sample": "The rest are corruptions — eiusmod for eius modi, incididunt for incidunt. Proportion is illustrative, not a measurement.",
                            "tone": "muted"
                          }
                        }
                      }
                    }
                  },
                  "faq": {
                    "role": "component",
                    "component": {
                      "v": "$components.types.accordions.styles.default",
                      "t": "ref"
                    },
                    "entries": [
                      {
                        "title": "Why not just type “text text text”?",
                        "body": "Repetition makes a visible pattern, and a pattern is exactly what you are trying to judge. Lorem Ipsum has the word-length and letter distribution of running prose without the meaning, so the eye reads the SHAPE."
                      },
                      {
                        "title": "Why not real English?",
                        "body": "Because you would read it. Meaningful copy pulls attention to the words and away from the type, the measure and the rhythm — the things a layout is being judged on. The trade is deliberate."
                      },
                      {
                        "title": "Is it actually Latin?",
                        "body": "It is Latin words in an order Cicero never wrote. Several are not words at all: the passage opens mid-word, and forms like eiusmod and incididunt are corruptions of the original eius modi and incidunt."
                      },
                      {
                        "title": "Does it hide problems?",
                        "body": "Yes, and this is the real argument against it. It cannot show you a heading that wraps badly in German, a name longer than its column, or an empty state. Content-shaped placeholder text catches those; Lorem Ipsum never will."
                      }
                    ],
                    "active": 0
                  }
