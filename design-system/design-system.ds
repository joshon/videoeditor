    "images": {
      "_description": "How pictures are presented. The picture itself is content, not a token — the system designs the frame, the crop, the corner and what happens under the pointer, and the app supplies which image goes in it.",
      "properties": {
        "aspect_ratio": {
          "v": "4 / 3",
          "t": "string"
        },
        "fit": {
          "v": "cover",
          "t": "string"
        },
        "position": {
          "v": "center",
          "t": "string"
        },
        "corner_radius": {
          "v": "$primitives.sizes.corners.md",
          "t": "ref"
        },
        "background": {
          "v": "$color_blocks.surfaces.002.properties.base",
          "t": "ref"
        },
        "transition": {
          "v": "$primitives.motions.snappy",
          "t": "ref"
        },
        "overlay_color": {
          "v": "$primitives.colors.basics.core.black",
          "t": "ref"
        },
        "overlay_opacity": {
          "v": "0",
          "t": "number"
        },
        "opacity": {
          "v": "1",
          "t": "number"
        },
        "scale": {
          "v": "1",
          "t": "number"
        }
      },
      "filters": {
        "none": {
          "_description": "The picture untouched. Named so a style can say it wants nothing rather than leave the question open.",
          "properties": {
            "blur": {
              "v": "0",
              "t": "px"
            },
            "brightness": {
              "v": "1",
              "t": "number"
            },
            "contrast": {
              "v": "1",
              "t": "number"
            },
            "saturate": {
              "v": "1",
              "t": "number"
            },
            "grayscale": {
              "v": "0",
              "t": "number"
            },
            "sepia": {
              "v": "0",
              "t": "number"
            },
            "hue_rotate": {
              "v": "0",
              "t": "number"
            }
          }
        },
        "muted": {
          "_description": "Drained and dimmed, for a picture that is context rather than subject — a disabled thumbnail, a card that is not the one you are on.",
          "properties": {
            "saturate": {
              "v": "0.45",
              "t": "number"
            },
            "brightness": {
              "v": "0.95",
              "t": "number"
            }
          }
        },
        "monochrome": {
          "_description": "All color removed. Editorial, and the honest way to stop a photograph competing with the brand.",
          "properties": {
            "grayscale": {
              "v": "1",
              "t": "number"
            }
          }
        },
        "scrim": {
          "_description": "Blurred and darkened, for a picture carrying text on top of it.",
          "properties": {
            "blur": {
              "v": "$primitives.effects.blurs.sm",
              "t": "ref"
            },
            "brightness": {
              "v": "0.8",
              "t": "number"
            }
          }
        }
      },
      "states": {
        "hover": {
          "_description": "What the pointer does. Zoom is the crop tightening inside a frame that does not move, which is why the frame has to clip.",
          "properties": {
            "scale": {
              "v": "1.04",
              "t": "number"
            },
            "filter": {
              "v": "$images.filters.none",
              "t": "ref"
            }
          }
        },
        "disabled": {
          "properties": {
            "filter": {
              "v": "$images.filters.muted",
              "t": "ref"
            },
            "opacity": {
              "v": "0.6",
              "t": "number"
            }
          }
        }
      },
      "sizes": {
