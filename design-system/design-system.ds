              "t": "color"
            },
            "005": {
              "v": "oklch(60.00% 0.12 250)",
              "t": "color"
            },
            "006": {
              "v": "oklch(45.00% 0.14 255)",
              "t": "color"
            }
          },
          "monochrome": {
            "_description": "Sequential – one hue at even lightness steps, for charts whose series do not need telling apart: a single measure over time, a ranked bar chart, small multiples. Ordered dark to light, so the first series reads strongest.",
            "000": {
              "v": "oklch(22.00% 0 0deg)",
              "t": "color"
            },
            "001": {
              "v": "oklch(31.50% 0 0deg)",
