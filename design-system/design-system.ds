            },
            "006": {
              "v": "oklch(79.00% 0 0deg)",
              "t": "color"
            },
            "007": {
              "v": "oklch(88.50% 0 0deg)",
              "t": "color"
            }
          },
          "categorical": {
            "_description": "Categorical – distinct hues for series that must be told apart: one per category, in a fixed order so the same series keeps the same color across charts. Ordered for maximum separation between neighbors; do not reorder them.",
