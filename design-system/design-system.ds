        "datavis": {
          "_description": "Colors optimized for data visualization, only use these for data visualization.",
          "diverging": {
            "_description": "Diverging – two ramps meeting at a neutral middle, for values read against a midpoint: profit and loss, above and below target, a swing between two parties. The middle step is the zero; do not reorder them.",
            "000": {
              "v": "oklch(45.00% 0.18 25)",
              "t": "color"
            },
            "001": {
              "v": "oklch(60.00% 0.15 25)",
              "t": "color"
            },
            "002": {
              "v": "oklch(78.00% 0.09 30)",
              "t": "color"
            },
            "003": {
              "v": "oklch(92.00% 0.01 90)",
              "t": "color"
            },
            "004": {
