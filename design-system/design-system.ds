    "layouts": {
      "deck": {
        "cover": {
          "description": "The cover page of the design system: its name, then a row of its colors.",
          "canvas": {
            "kind": "fixed",
            "width": {
              "v": "1920",
              "t": "px"
            },
            "height": {
              "v": "1080",
              "t": "px"
            }
          },
          "grid": {
            "columns": 12,
            "gutter": {
              "v": "32",
              "t": "px"
            },
            "margin": {
              "v": "80",
              "t": "px"
            }
          },
          "regions": {
            "head": {
              "area": "top"
            },
            "foot": {
              "area": "bottom"
            }
          }
        }
      },
      "web": {
        "lorem_ipsum_page": {
          "description": "The Lorem Ipsum page: a masthead, a hero, the passage, the tabbed sections, a form, a footer.",
          "canvas": {
            "kind": "fluid",
            "max_width": {
              "v": "900",
              "t": "px"
            }
          },
          "grid": {
            "columns": 12,
            "gutter": {
              "v": "$primitives.sizes.spacing.5xl",
              "t": "ref"
            },
            "margin": {
              "v": "$primitives.sizes.spacing.4xl",
              "t": "ref"
            }
          },
          "regions": {
            "masthead": {
              "area": "top"
            },
            "hero": {
              "area": "center",
              "span": 12,
              "band": 1
            },
            "passage": {
              "area": "center",
              "span": 12,
              "band": 2
            },
            "explore": {
              "area": "center",
              "span": 12,
              "band": 3
            },
            "generator": {
              "area": "center",
              "span": 12,
              "band": 4
            },
            "footer": {
              "area": "bottom"
            }
          }
        },
