              "v": "$primitives.sizes.widths.xl",
              "t": "ref"
            }
          }
        }
      },
      "styles": {
        "product": {
          "_description": "A thing for sale, filling the tile top to bottom so a row of cards reads as one band. Its own ratio decides the width from there — narrower than the frame, or wider and cropped at the sides.",
          "properties": {
            "fit": {
              "v": "height",
              "t": "string"
            },
            "aspect_ratio": {
              "v": "4 / 3",
              "t": "string"
            }
